# Public URL used by the Expo app to reach the Geniuz API. This is not a secret.
EXPO_PUBLIC_GENIUZ_API_URL=

# Supabase project URL and publishable key. Never use a service_role key in the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set to true only when sample titles are explicitly wanted.
EXPO_PUBLIC_USE_DEMO_CATALOG=false

# Backend-only settings. Keep these out of Expo/mobile builds.
PORT=4000
SUPABASE_URL=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
ANILIST_API_URL=https://graphql.anilist.co
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,https://YOUR-CODESPACE-8081.app.github.dev
CATALOG_CACHE_TTL_SECONDS=300
